# --- HealthID AI Environment Variables ---

# OpenAI API Key (Required for GPT-4o Vision OCR pipeline)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (PostgreSQL Docker container)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/healthid_db
# DATABASE_URL=sqlite:///./healthid.db

# Authentication Settings
SECRET_KEY=your_secure_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Settings for OTP Verification (SMTP)
# If left blank, OTPs will just be printed to the backend console for local testing.
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password

# Langsmith API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="<your-langsmith-api-key>"
LANGCHAIN_PROJECT="HealthID-AI"
